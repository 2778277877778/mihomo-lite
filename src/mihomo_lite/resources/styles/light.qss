/* Mihomo Lite - liquid glass (light) */
QPushButton:focus, QComboBox:focus, QSpinBox:focus, QLineEdit:focus,
QCheckBox:focus {
    border: 1px solid #4f7bff;
}
QListWidget:focus { border: 1px solid #4f7bff; }
QListWidget#Nav:focus { border: none; }

QWidget {
    background: transparent;
    color: #101521;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QMessageBox, QInputDialog {
    background-color: #f4f6fb;
}

QDialog QWidget, QMessageBox QWidget { background: transparent; }
QMessageBox QLabel { color: #101521; }

/* ---- title bar ------------------------------------------------------- */
QWidget#TitleBar { background: transparent; }
QLabel#TitleDot { color: #2f6bff; font-size: 10px; }
QLabel#TitleText {
    color: rgba(16, 21, 33, 0.55);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
}
QLabel#TitleStatus { color: rgba(16, 21, 33, 0.42); font-size: 11px; padding-left: 8px; }

QPushButton#WinButton, QPushButton#WinClose {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(16, 21, 33, 0.06);
    border-radius: 10px;
    color: rgba(16, 21, 33, 0.65);
    font-size: 11px;
    padding: 0;
}
QPushButton#WinButton:hover { background: rgba(255, 255, 255, 0.95); color: #101521; }
QPushButton#WinClose:hover { background: #ff5f6d; border-color: #ff5f6d; color: #ffffff; }

/* ---- sidebar --------------------------------------------------------- */
QFrame#Sidebar {
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 22px;
}
QLabel#Brand { font-size: 16px; font-weight: 600; padding: 4px 8px 0 8px; }
QLabel#BrandSub { color: rgba(16, 21, 33, 0.42); font-size: 10px; padding: 2px 8px 0 8px; }

QListWidget#Nav { background: transparent; border: none; padding: 0; }
QListWidget#Nav::item {
    color: rgba(16, 21, 33, 0.60);
    padding: 9px 14px;
    margin: 2px 0;
    border-radius: 12px;
}
QListWidget#Nav::item:hover { background: rgba(255, 255, 255, 0.75); color: #101521; }
QListWidget#Nav::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(79, 123, 255, 0.18), stop:1 rgba(123, 107, 255, 0.14));
    border: 1px solid rgba(255, 255, 255, 0.90);
    color: #101521;
    font-weight: 600;
}

/* ---- glass surfaces -------------------------------------------------- */
QFrame#Card, QFrame#HeroCard {
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 22px;
}
QFrame#HeroCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255, 255, 255, 0.88), stop:1 rgba(255, 255, 255, 0.58));
    border: 1px solid #ffffff;
    border-radius: 24px;
}

/* ---- text ------------------------------------------------------------ */
QLabel#PageTitle { font-size: 24px; font-weight: 600; }
QLabel#PageSubtitle { color: rgba(16, 21, 33, 0.52); font-size: 13px; }
QLabel#Hint { color: rgba(16, 21, 33, 0.50); font-size: 12px; }
QLabel#Metric { font-size: 20px; font-weight: 600; }
QLabel#MetricLabel { color: rgba(16, 21, 33, 0.45); font-size: 10px; letter-spacing: 1px; }
QLabel#KeyValue { color: rgba(16, 21, 33, 0.82); }
QLabel#FooterText { color: rgba(16, 21, 33, 0.50); font-size: 11px; }

/* ---- buttons --------------------------------------------------------- */
QPushButton {
    background: rgba(255, 255, 255, 0.70);
    border: 1px solid rgba(16, 21, 33, 0.07);
    border-radius: 14px;
    padding: 8px 16px;
    color: #101521;
}
QPushButton:hover { background: rgba(255, 255, 255, 0.96); border-color: rgba(16, 21, 33, 0.12); }
QPushButton:pressed { background: rgba(240, 243, 250, 0.95); }
QPushButton:disabled {
    color: rgba(16, 21, 33, 0.30);
    background: rgba(255, 255, 255, 0.35);
    border-color: rgba(16, 21, 33, 0.04);
}

QPushButton#Primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4f7bff, stop:1 #7b6bff);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 16px;
    color: #ffffff;
    font-weight: 600;
    padding: 10px 22px;
}
QPushButton#Primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6189ff, stop:1 #8a7cff);
}
QPushButton#Primary:disabled {
    background: rgba(79, 123, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.45);
    color: rgba(255, 255, 255, 0.75);
}

QPushButton#Danger { color: #d64550; border-color: rgba(214, 69, 80, 0.20); }
QPushButton#Danger:hover { background: rgba(255, 95, 109, 0.14); }

QPushButton#Ghost { background: transparent; border-color: transparent; color: rgba(16, 21, 33, 0.55); }
QPushButton#Ghost:hover { background: rgba(255, 255, 255, 0.70); color: #101521; }

/* ---- lists ----------------------------------------------------------- */
QListWidget {
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: 18px;
    padding: 7px;
}
QListWidget::item { padding: 10px 12px; border-radius: 12px; margin: 2px 0; color: rgba(16, 21, 33, 0.85); }
QListWidget::item:hover { background: rgba(255, 255, 255, 0.80); }
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(79, 123, 255, 0.22), stop:1 rgba(123, 107, 255, 0.16));
    color: #101521;
}

/* ---- inputs ---------------------------------------------------------- */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(16, 21, 33, 0.07);
    border-radius: 13px;
    padding: 7px 11px;
    selection-background-color: rgba(79, 123, 255, 0.25);
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border-color: rgba(79, 123, 255, 0.55);
    background: rgba(255, 255, 255, 0.95);
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid rgba(16, 21, 33, 0.08);
    border-radius: 12px;
    padding: 4px;
    selection-background-color: rgba(79, 123, 255, 0.18);
}

QCheckBox { spacing: 9px; color: rgba(16, 21, 33, 0.80); }
QCheckBox::indicator {
    width: 17px; height: 17px;
    border-radius: 6px;
    border: 1px solid rgba(16, 21, 33, 0.18);
    background: rgba(255, 255, 255, 0.85);
}
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4f7bff, stop:1 #7b6bff);
    border-color: rgba(79, 123, 255, 0.65);
}

QProgressBar {
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(16, 21, 33, 0.06);
    border-radius: 7px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4f7bff, stop:1 #7b6bff);
    border-radius: 6px;
}

/* ---- scrollbars ------------------------------------------------------ */
QScrollArea { border: none; background: transparent; }
QSplitter::handle { background: transparent; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 3px; }
QScrollBar::handle:vertical { background: rgba(16, 21, 33, 0.16); border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: rgba(16, 21, 33, 0.28); }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 3px; }
QScrollBar::handle:horizontal { background: rgba(16, 21, 33, 0.16); border-radius: 4px; min-width: 28px; }

/* ---- footer ---------------------------------------------------------- */
QFrame#Footer {
    background: rgba(255, 255, 255, 0.45);
    border-top: 1px solid rgba(255, 255, 255, 0.85);
}

/* ---- status pill ----------------------------------------------------- */
QLabel#StatusPill {
    border-radius: 15px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(16, 21, 33, 0.06);
    color: rgba(16, 21, 33, 0.62);
}
QLabel#StatusPill[state="connected"] {
    background: rgba(18, 178, 118, 0.14);
    border-color: rgba(18, 178, 118, 0.30);
    color: #0b7a52;
}
QLabel#StatusPill[state="starting"], QLabel#StatusPill[state="stopping"] {
    background: rgba(214, 138, 0, 0.14);
    border-color: rgba(214, 138, 0, 0.28);
    color: #96600a;
}
QLabel#StatusPill[state="error"] {
    background: rgba(214, 69, 80, 0.14);
    border-color: rgba(214, 69, 80, 0.28);
    color: #b3323d;
}

QLabel#TitleStatus[state="connected"] { color: #0b7a52; }

QPlainTextEdit#LogView {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    color: rgba(16, 21, 33, 0.78);
}

QToolTip {
    background: #ffffff;
    color: #101521;
    border: 1px solid rgba(16, 21, 33, 0.10);
    border-radius: 8px;
    padding: 6px 8px;
}
