/* Mihomo Lite - light theme */
QWidget {
    background-color: #f5f6f8;
    color: #1c1f26;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QWidget#Root { background-color: #f5f6f8; }

QLabel, QCheckBox, QRadioButton { background-color: transparent; }

QFrame#Sidebar {
    background-color: #ffffff;
    border-right: 1px solid #dde1e8;
}

QLabel#Brand { font-size: 17px; font-weight: 600; padding: 18px 16px 4px 18px; }
QLabel#BrandSub { color: #6b7280; font-size: 11px; padding: 0 16px 14px 18px; }

QLabel#PageTitle { font-size: 22px; font-weight: 600; }
QLabel#PageSubtitle { color: #6b7280; }
QLabel#Hint { color: #6b7280; font-size: 12px; }
QLabel#Metric { font-size: 20px; font-weight: 600; }
QLabel#MetricLabel { color: #6b7280; font-size: 11px; }
QLabel#KeyValue { color: #384252; }

QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #dde1e8;
    border-radius: 12px;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #dde1e8;
    border-radius: 8px;
    padding: 7px 14px;
    color: #1c1f26;
}
QPushButton:hover { background-color: #eef1f6; }
QPushButton:pressed { background-color: #e3e7ee; }
QPushButton:disabled { color: #a3a9b4; }

QPushButton#Primary {
    background-color: #2563eb;
    border: 1px solid #2563eb;
    color: #ffffff;
    font-weight: 600;
    padding: 9px 18px;
}
QPushButton#Primary:hover { background-color: #3b76f0; }
QPushButton#Primary:disabled { background-color: #b9caf0; border-color: #b9caf0; color: #ffffff; }

QPushButton#Danger { color: #d13438; border-color: #f0c9ca; }
QPushButton#Danger:hover { background-color: #fdeff0; }

QPushButton#Ghost { background-color: transparent; border-color: transparent; color: #6b7280; }
QPushButton#Ghost:hover { background-color: #eef1f6; color: #1c1f26; }

QListWidget {
    background-color: #ffffff;
    border: 1px solid #dde1e8;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}
QListWidget::item { padding: 9px 10px; border-radius: 7px; margin: 2px 0; }
QListWidget::item:hover { background-color: #f0f3f8; }
QListWidget::item:selected { background-color: #dbe6ff; color: #1c1f26; }

QListWidget#Nav { background: transparent; border: none; padding: 4px 8px; }
QListWidget#Nav::item {
    padding: 10px 12px;
    margin: 3px 6px;
    color: #6b7280;
    border-radius: 8px;
}
QListWidget#Nav::item:hover { background-color: #eef1f6; color: #1c1f26; }
QListWidget#Nav::item:selected { background-color: #eef1f6; color: #1c1f26; font-weight: 600; }

QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #dde1e8;
    border-radius: 8px;
    padding: 6px 9px;
    selection-background-color: #dbe6ff;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus { border-color: #2563eb; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #dde1e8;
    selection-background-color: #dbe6ff;
}

QCheckBox { spacing: 8px; color: #384252; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 4px;
    border: 1px solid #c7cdd8;
    background-color: #ffffff;
}
QCheckBox::indicator:checked { background-color: #2563eb; border-color: #2563eb; }

QProgressBar {
    background-color: #eef1f6;
    border: 1px solid #dde1e8;
    border-radius: 6px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background-color: #2563eb; border-radius: 5px; }

QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background-color: #dde1e8; }

QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #c7cdd8; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #aeb6c4; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QStatusBar { background-color: #ffffff; color: #6b7280; border-top: 1px solid #dde1e8; }

QToolTip {
    background-color: #1c1f26;
    color: #ffffff;
    border: none;
    padding: 4px 6px;
}

QLabel#StatusPill {
    border-radius: 11px;
    padding: 3px 12px;
    font-size: 12px;
    font-weight: 600;
    background-color: #eef1f6;
    color: #6b7280;
}
QLabel#StatusPill[state="connected"] { background-color: #dcf6ea; color: #0f9d63; }
QLabel#StatusPill[state="starting"], QLabel#StatusPill[state="stopping"] { background-color: #fdf0d8; color: #b76e00; }
QLabel#StatusPill[state="error"] { background-color: #fdecec; color: #d13438; }

QPlainTextEdit#LogView {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    background-color: #ffffff;
    color: #384252;
}
