/* Mihomo Lite - liquid glass (dark) */
QPushButton:focus, QComboBox:focus, QSpinBox:focus, QLineEdit:focus,
QCheckBox:focus {
    border: 1px solid #7aa2ff;
}
QListWidget:focus { border: 1px solid #7aa2ff; }
QListWidget#Nav:focus { border: none; }

QWidget {
    background: transparent;
    color: #eef2f9;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QMessageBox, QInputDialog {
    background-color: #121722;
}

QDialog QWidget, QMessageBox QWidget { background: transparent; }
QMessageBox QLabel { color: #eef2f9; }

/* ---- title bar ------------------------------------------------------- */
QWidget#TitleBar { background: transparent; }
QLabel#TitleDot { color: #7aa2ff; font-size: 10px; }
QLabel#TitleText {
    color: rgba(238, 242, 249, 0.55);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
}
QLabel#TitleStatus { color: rgba(238, 242, 249, 0.40); font-size: 11px; padding-left: 8px; }

QPushButton#WinButton, QPushButton#WinClose {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    color: rgba(238, 242, 249, 0.70);
    font-size: 11px;
    padding: 0;
}
QPushButton#WinButton:hover { background: rgba(255, 255, 255, 0.14); color: #ffffff; }
QPushButton#WinClose:hover { background: #ff5f6d; border-color: #ff5f6d; color: #ffffff; }

/* ---- sidebar --------------------------------------------------------- */
QFrame#Sidebar {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 22px;
}
QLabel#Brand { font-size: 16px; font-weight: 600; padding: 4px 8px 0 8px; }
QLabel#BrandSub { color: rgba(238, 242, 249, 0.38); font-size: 10px; padding: 2px 8px 0 8px; }

QListWidget#Nav { background: transparent; border: none; padding: 0; }
QListWidget#Nav::item {
    color: rgba(238, 242, 249, 0.62);
    padding: 9px 14px;
    margin: 2px 0;
    border-radius: 12px;
}
QListWidget#Nav::item:hover { background: rgba(255, 255, 255, 0.07); color: #ffffff; }
QListWidget#Nav::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(122, 162, 255, 0.30), stop:1 rgba(143, 123, 255, 0.22));
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-weight: 600;
}

/* ---- glass surfaces -------------------------------------------------- */
QFrame#Card, QFrame#HeroCard {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 22px;
}
QFrame#HeroCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255, 255, 255, 0.10), stop:1 rgba(255, 255, 255, 0.045));
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 24px;
}

/* ---- text ------------------------------------------------------------ */
QLabel#PageTitle { font-size: 24px; font-weight: 600; }
QLabel#PageSubtitle { color: rgba(238, 242, 249, 0.50); font-size: 13px; }
QLabel#Hint { color: rgba(238, 242, 249, 0.45); font-size: 12px; }
QLabel#Metric { font-size: 20px; font-weight: 600; }
QLabel#MetricLabel { color: rgba(238, 242, 249, 0.42); font-size: 10px; letter-spacing: 1px; }
QLabel#KeyValue { color: rgba(238, 242, 249, 0.82); }
QLabel#FooterText { color: rgba(238, 242, 249, 0.45); font-size: 11px; }

/* ---- buttons --------------------------------------------------------- */
QPushButton {
    background: rgba(255, 255, 255, 0.075);
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 15px;
    padding: 10px 18px;
    min-height: 20px;
    color: #eef2f9;
}
QPushButton:hover { background: rgba(255, 255, 255, 0.14); border-color: rgba(255, 255, 255, 0.20); }
QPushButton:pressed { background: rgba(255, 255, 255, 0.09); }
QPushButton:disabled {
    color: rgba(238, 242, 249, 0.28);
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.05);
}

QPushButton#Primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6f9bff, stop:1 #9377ff);
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: 16px;
    color: #ffffff;
    font-weight: 600;
    padding: 10px 22px;
}
QPushButton#Primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #82a9ff, stop:1 #a189ff);
}
QPushButton#Primary:disabled {
    background: rgba(122, 162, 255, 0.20);
    border-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.45);
}

QPushButton#Danger { color: #ff8a97; border-color: rgba(255, 122, 138, 0.28); }
QPushButton#Danger:hover { background: rgba(255, 95, 109, 0.18); }

QPushButton#Ghost { background: transparent; border-color: transparent; color: rgba(238, 242, 249, 0.55); }
QPushButton#Ghost:hover { background: rgba(255, 255, 255, 0.08); color: #ffffff; }

/* ---- lists ----------------------------------------------------------- */
QListWidget {
    background: rgba(0, 0, 0, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 7px;
}
QListWidget::item { padding: 12px 14px; border-radius: 12px; margin: 2px 0; color: rgba(238, 242, 249, 0.82); }
QListWidget::item:hover { background: rgba(255, 255, 255, 0.07); }
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(122, 162, 255, 0.34), stop:1 rgba(143, 123, 255, 0.24));
    color: #ffffff;
}

/* ---- inputs ---------------------------------------------------------- */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 13px;
    padding: 8px 12px;
    min-height: 20px;
    selection-background-color: rgba(122, 162, 255, 0.45);
    selection-color: #ffffff;
}
QComboBox { padding-right: 36px; }
QComboBox::drop-down {
    width: 32px;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.10);
}
QComboBox QAbstractItemView::item { min-height: 30px; padding: 4px 10px; }
QSpinBox { padding-right: 32px; }
QSpinBox::up-button, QSpinBox::down-button {
    width: 28px;
    background: rgba(255, 255, 255, 0.07);
    border-left: 1px solid rgba(255, 255, 255, 0.10);
}
QSpinBox::up-button { border-top-right-radius: 12px; }
QSpinBox::down-button { border-bottom-right-radius: 12px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 0.16);
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border-color: rgba(122, 162, 255, 0.75);
    background: rgba(0, 0, 0, 0.30);
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #161c2a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 4px;
    selection-background-color: rgba(122, 162, 255, 0.35);
}

QCheckBox { spacing: 10px; min-height: 24px; color: rgba(238, 242, 249, 0.80); }
QCheckBox::indicator {
    width: 20px; height: 20px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    background: rgba(0, 0, 0, 0.25);
}
QCheckBox::indicator:hover { border-color: rgba(255, 255, 255, 0.50); }
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6f9bff, stop:1 #9377ff);
    border-color: rgba(255, 255, 255, 0.35);
}

QProgressBar {
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 7px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6f9bff, stop:1 #9377ff);
    border-radius: 6px;
}

/* ---- scrollbars ------------------------------------------------------ */
QScrollArea { border: none; background: transparent; }
QSplitter::handle { background: transparent; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 3px; }
QScrollBar::handle:vertical { background: rgba(255, 255, 255, 0.16); border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: rgba(255, 255, 255, 0.28); }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 3px; }
QScrollBar::handle:horizontal { background: rgba(255, 255, 255, 0.16); border-radius: 4px; min-width: 28px; }

/* ---- footer ---------------------------------------------------------- */
QFrame#Footer {
    background: rgba(255, 255, 255, 0.035);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
}

/* ---- status pill ----------------------------------------------------- */
QLabel#StatusPill {
    border-radius: 15px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: rgba(238, 242, 249, 0.65);
}
QLabel#StatusPill[state="connected"] {
    background: rgba(70, 224, 160, 0.16);
    border-color: rgba(70, 224, 160, 0.35);
    color: #7cf0bc;
}
QLabel#StatusPill[state="starting"], QLabel#StatusPill[state="stopping"] {
    background: rgba(255, 196, 107, 0.15);
    border-color: rgba(255, 196, 107, 0.32);
    color: #ffd399;
}
QLabel#StatusPill[state="error"] {
    background: rgba(255, 123, 138, 0.15);
    border-color: rgba(255, 123, 138, 0.32);
    color: #ff9aa6;
}

QLabel#TitleStatus[state="connected"] { color: #7cf0bc; }

QPlainTextEdit#LogView {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    background: rgba(0, 0, 0, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    color: rgba(238, 242, 249, 0.72);
}

QToolTip {
    background: #1b2230;
    color: #eef2f9;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 6px 8px;
}
